:root {
	/* =~= Theme Properties =~= */
	--theme-font-family-base: system-ui;
	--theme-font-family-heading: system-ui;
	--theme-font-color-base: 0 0 0;
	--theme-font-color-dark: 255 255 255;
	--theme-rounded-base: 12px;
	--theme-rounded-container: 8px;
	--theme-border-base: 1px;
	/* =~= Theme On-X Colors =~= */
	--on-primary: 255 255 255;
	--on-secondary: 255 255 255;
	--on-tertiary: 0 0 0;
	--on-success: 0 0 0;
	--on-warning: 0 0 0;
	--on-error: 255 255 255;
	--on-surface: 255 255 255;
	/* =~= Theme Colors  =~= */
	/* primary | #000000 */
	--color-primary-50: 217 217 217; /* ⬅ #d9d9d9 */
	--color-primary-100: 204 204 204; /* ⬅ #cccccc */
	--color-primary-200: 191 191 191; /* ⬅ #bfbfbf */
	--color-primary-300: 153 153 153; /* ⬅ #999999 */
	--color-primary-400: 77 77 77; /* ⬅ #4d4d4d */
	--color-primary-500: 0 0 0; /* ⬅ #000000 */
	--color-primary-600: 0 0 0; /* ⬅ #000000 */
	--color-primary-700: 0 0 0; /* ⬅ #000000 */
	--color-primary-800: 0 0 0; /* ⬅ #000000 */
	--color-primary-900: 0 0 0; /* ⬅ #000000 */
	/* secondary | #a50626 */
	--color-secondary-50: 242 218 222; /* ⬅ #f2dade */
	--color-secondary-100: 237 205 212; /* ⬅ #edcdd4 */
	--color-secondary-200: 233 193 201; /* ⬅ #e9c1c9 */
	--color-secondary-300: 219 155 168; /* ⬅ #db9ba8 */
	--color-secondary-400: 192 81 103; /* ⬅ #c05167 */
	--color-secondary-500: 165 6 38; /* ⬅ #a50626 */
	--color-secondary-600: 149 5 34; /* ⬅ #950522 */
	--color-secondary-700: 124 5 29; /* ⬅ #7c051d */
	--color-secondary-800: 99 4 23; /* ⬅ #630417 */
	--color-secondary-900: 81 3 19; /* ⬅ #510313 */
	/* tertiary | #f82a2c */
	--color-tertiary-50: 254 223 223; /* ⬅ #fedfdf */
	--color-tertiary-100: 254 212 213; /* ⬅ #fed4d5 */
	--color-tertiary-200: 253 202 202; /* ⬅ #fdcaca */
	--color-tertiary-300: 252 170 171; /* ⬅ #fcaaab */
	--color-tertiary-400: 250 106 107; /* ⬅ #fa6a6b */
	--color-tertiary-500: 248 42 44; /* ⬅ #f82a2c */
	--color-tertiary-600: 223 38 40; /* ⬅ #df2628 */
	--color-tertiary-700: 186 32 33; /* ⬅ #ba2021 */
	--color-tertiary-800: 149 25 26; /* ⬅ #95191a */
	--color-tertiary-900: 122 21 22; /* ⬅ #7a1516 */
	/* success | #84cc16 */
	--color-success-50: 237 247 220; /* ⬅ #edf7dc */
	--color-success-100: 230 245 208; /* ⬅ #e6f5d0 */
	--color-success-200: 224 242 197; /* ⬅ #e0f2c5 */
	--color-success-300: 206 235 162; /* ⬅ #ceeba2 */
	--color-success-400: 169 219 92; /* ⬅ #a9db5c */
	--color-success-500: 132 204 22; /* ⬅ #84cc16 */
	--color-success-600: 119 184 20; /* ⬅ #77b814 */
	--color-success-700: 99 153 17; /* ⬅ #639911 */
	--color-success-800: 79 122 13; /* ⬅ #4f7a0d */
	--color-success-900: 65 100 11; /* ⬅ #41640b */
	/* warning | #ec790e */
	--color-warning-50: 252 235 219; /* ⬅ #fcebdb */
	--color-warning-100: 251 228 207; /* ⬅ #fbe4cf */
	--color-warning-200: 250 222 195; /* ⬅ #fadec3 */
	--color-warning-300: 247 201 159; /* ⬅ #f7c99f */
	--color-warning-400: 242 161 86; /* ⬅ #f2a156 */
	--color-warning-500: 236 121 14; /* ⬅ #ec790e */
	--color-warning-600: 212 109 13; /* ⬅ #d46d0d */
	--color-warning-700: 177 91 11; /* ⬅ #b15b0b */
	--color-warning-800: 142 73 8; /* ⬅ #8e4908 */
	--color-warning-900: 116 59 7; /* ⬅ #743b07 */
	/* error | #de0d30 */
	--color-error-50: 250 219 224; /* ⬅ #fadbe0 */
	--color-error-100: 248 207 214; /* ⬅ #f8cfd6 */
	--color-error-200: 247 195 203; /* ⬅ #f7c3cb */
	--color-error-300: 242 158 172; /* ⬅ #f29eac */
	--color-error-400: 232 86 110; /* ⬅ #e8566e */
	--color-error-500: 222 13 48; /* ⬅ #de0d30 */
	--color-error-600: 200 12 43; /* ⬅ #c80c2b */
	--color-error-700: 167 10 36; /* ⬅ #a70a24 */
	--color-error-800: 133 8 29; /* ⬅ #85081d */
	--color-error-900: 109 6 24; /* ⬅ #6d0618 */
	/* surface | #c21919 */
	--color-surface-50: 246 221 221; /* ⬅ #f6dddd */
	--color-surface-100: 243 209 209; /* ⬅ #f3d1d1 */
	--color-surface-200: 240 198 198; /* ⬅ #f0c6c6 */
	--color-surface-300: 231 163 163; /* ⬅ #e7a3a3 */
	--color-surface-400: 212 94 94; /* ⬅ #d45e5e */
	--color-surface-500: 194 25 25; /* ⬅ #c21919 */
	--color-surface-600: 175 23 23; /* ⬅ #af1717 */
	--color-surface-700: 146 19 19; /* ⬅ #921313 */
	--color-surface-800: 116 15 15; /* ⬅ #740f0f */
	--color-surface-900: 95 12 12; /* ⬅ #5f0c0c */
}

#page {
}

