@tailwind base;
@tailwind components;
@tailwind utilities;

html,
body {
	@apply h-screen overflow-hidden;
	@apply bg-surface-50 dark:bg-surface-900 text-surface-900 dark:text-surface-50;
	padding-bottom: env(safe-area-inset-bottom, 20px);
}

.list-nav a {
	@apply rounded-none;
}

.dark p {
	color: rgb(var(--color-surface-300) / var(--tw-text-opacity));
}

.searchDropdown {
	@apply bg-surface-300;
}

.dark .searchDropdown {
	@apply bg-surface-500;
}

.craftingRecipe {
	@apply flex flex-col lg:flex-row items-center justify-around mt-3 mb-5;
}

.textblock {
	min-width: 80vw;
}

.craftingGrid {
	display: grid;
	gap: 0.5rem;
	grid-template-columns: repeat(3, minmax(90px, 1fr));
}

.craftingGridItem {
	width: 90px;
	height: 90px;
}

.craftingGridPicture {
	width: 50px;
	height: 50px;
	image-rendering: pixelated;
}

@media (min-width: 1024px) {
	.craftingGridItem {
		width: 110px;
		height: 110px;
	}

	.craftingGridPicture {
		width: 65px;
		height: 65px;
	}

	.craftingGrid {
		grid-template-columns: repeat(3, minmax(110px, 1fr));
	}

	.textblock {
		min-width: 65ch;
	}

	.page {
		min-height: 88vh;
	}

	.craftingRecipe {
		left: 50%;
		margin-left: -25vw;
		margin-right: -50vw;
		max-width: 50vw;
		position: relative;
		right: 50%;
	}
}

.accordion-summary-lead {
	flex-shrink: 0;
}

/* UI/UX Global Enhancements */
.glass-panel {
	@apply bg-surface-100/70 dark:bg-surface-800/70 backdrop-blur-md border border-surface-200/50 dark:border-surface-700/50 shadow-xl;
}

.glass-header {
	@apply bg-surface-50/80 dark:bg-surface-900/80 backdrop-blur-lg border-b border-surface-200/50 dark:border-surface-700/50 shadow-sm;
}

.hover-card {
	@apply transition-all duration-300 ease-out hover:-translate-y-1 hover:shadow-2xl hover:border-primary-500/30;
}
