@tailwind base;
@tailwind components;
@tailwind utilities;

html,
body {
	@apply h-screen overflow-hidden;
	@apply bg-surface-50 dark:bg-surface-900 text-surface-900 dark:text-surface-50;
	padding-bottom: env(safe-area-inset-bottom, 20px);
}

.list-nav a {
	@apply rounded-none;
}

.dark p {
	color: rgb(var(--color-surface-300) / var(--tw-text-opacity));
}

.searchDropdown {
	@apply bg-surface-300;
}

.dark .searchDropdown {
	@apply bg-surface-500;
}

.craftingRecipe {
	@apply flex flex-col lg:flex-row items-center justify-around mt-3 mb-5;
}

.textblock {
	@apply w-full max-w-full leading-relaxed;
	overflow-wrap: break-word;
	word-break: break-word;
}

.textblock a,
.formatted-label a,
.prose a {
	@apply text-primary-600 dark:text-primary-400 font-semibold underline decoration-primary-500/60 hover:decoration-primary-500 underline-offset-4 transition-all;
}

.textblock a:hover,
.formatted-label a:hover,
.prose a:hover {
	@apply text-primary-700 dark:text-primary-300;
}

.formatted-label p {
	margin-bottom: 0.75rem;
}

.formatted-label p:last-child {
	margin-bottom: 0;
}

h1 .formatted-label p,
h2 .formatted-label p,
h3 .formatted-label p,
h4 .formatted-label p,
h5 .formatted-label p,
h6 .formatted-label p,
strong .formatted-label p {
	display: inline;
	margin-bottom: 0;
}

.craftingGrid {
	display: grid;
	gap: 0.5rem;
	grid-template-columns: repeat(3, minmax(90px, 1fr));
}

.craftingGridItem {
	width: 90px;
	height: 90px;
}

.craftingGridPicture {
	width: 50px;
	height: 50px;
	image-rendering: pixelated;
}

@media (min-width: 1024px) {
	.craftingGridItem {
		width: 110px;
		height: 110px;
	}

	.craftingGridPicture {
		width: 65px;
		height: 65px;
	}

	.craftingGrid {
		grid-template-columns: repeat(3, minmax(110px, 1fr));
	}

	.page {
		min-height: 88vh;
	}
}

.accordion-summary-lead {
	flex-shrink: 0;
}

/* UI/UX Global Enhancements */
.glass-panel {
	@apply bg-surface-100/70 dark:bg-surface-800/70 backdrop-blur-md border border-surface-200/50 dark:border-surface-700/50 shadow-xl;
}

.glass-header {
	@apply bg-surface-50/80 dark:bg-surface-900/80 backdrop-blur-lg border-b border-surface-200/50 dark:border-surface-700/50 shadow-sm;
}

.hover-card {
	@apply transition-all duration-300 ease-out hover:-translate-y-1 hover:shadow-2xl hover:border-primary-500/30;
}
